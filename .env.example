# Copy to .env.local and fill in (Supabase Dashboard -> Settings -> API).
# Orders are saved in Supabase; leave empty to keep orders in the browser only.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# true = save orders in Supabase + enable /track; anything else = orders stay in the browser
VITE_ORDERS_ONLINE=false
# Local development only: connect admin orders automatically (ignored in production builds)
VITE_ORDERS_ADMIN_EMAIL=
VITE_ORDERS_ADMIN_PASSWORD=
